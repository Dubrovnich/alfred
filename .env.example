# --- Which model answers guests -------------------------------------------
# Claude (for paying customers):
ALFRED_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ALFRED_MODEL=claude-haiku-5-5

# Free for demos instead: Gemini's free tier through its OpenAI-compatible endpoint.
# Key from https://aistudio.google.com/apikey. The free tier may use the chats to
# improve Google's models, so don't put real guests on it.
# ALFRED_PROVIDER=openai
# ALFRED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ALFRED_API_KEY=
# ALFRED_MODEL=gemini-2.5-flash   (or whatever Flash model AI Studio lists as current)

ALFRED_MAX_OUTPUT_TOKENS=350

# --- Alerts -----------------------------------------------------------------
# escalations go to the host's phone on Telegram (can be Ted's bot token)
TELEGRAM_BOT_TOKEN=
# chat that gets alerts for properties without their own telegram_chat_id (the demo)
ALFRED_ALERT_CHAT_ID=
